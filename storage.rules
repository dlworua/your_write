rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 관리자 권한 확인 함수
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // popup_images 폴더: 공개 읽기, 인증된 사용자만 쓰기/삭제
    match /popup_images/{imageName} {
      allow read: if true;  // 공개 읽기로 변경 (CORS 문제 해결)
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // 루트 폴더 이미지들 (기존 업로드된 파일들): 공개 읽기
    match /{fileName} {
      allow read: if true;  // 기존 파일들도 공개 읽기
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // 그 외 모든 경로는 기본 차단
    match /{folder}/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
